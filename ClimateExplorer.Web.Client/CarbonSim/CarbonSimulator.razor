@page "/carbon-sim"
@using ClimateExplorer.CarbonCycle.Simulation
@using ClimateExplorer.Web.Client.CarbonSim.Common
@using ClimateExplorer.Web.Client.CarbonSim.Components
@using ClimateExplorer.Web.Client.CarbonSim.Scenarios
@using static ClimateExplorer.Core.Enums

<PageTitle>ClimateExplorer - Carbon-cycle simulator</PageTitle>

<HeadContent>
    <meta name="description" content="Burn methane in a sealed house, or petrol on a dead planet, and watch the air change." />
</HeadContent>

<div class="carbon-sim">
    <h1>Carbon-cycle simulator</h1>

    <Tabs Id="@TabsId" AriaLabel="Inputs" SelectedTab="@selectedTab" SelectedTabChanged="OnSelectedTabChanged">
        <Tab Name="@FossilTab">Fossil fuels and limestone</Tab>
        <Tab Name="land" Disabled="true">Land and agriculture</Tab>
        <Tab Name="waste" Disabled="true">Waste and industrial gases</Tab>
    </Tabs>

    <div class="tab-panel" role="tabpanel" aria-labelledby="@Tabs.IdFor(TabsId, FossilTab)">
        <Carousel TItem="Scenario"
                  Items="@ScenarioCatalog.All"
                  Index="@scenarioIndex"
                  IndexChanged="OnScenarioChangedAsync"
                  AriaLabel="Scenarios"
                  ItemLabel="@(x => x.Title)">
            <ItemTemplate Context="slide">
                <DynamicComponent Type="@slide.Item.Component" Parameters="@ScenarioParameters(slide)" />
            </ItemTemplate>
        </Carousel>
    </div>

    <div class="clock" role="group" aria-label="Simulation clock">
        <Button Icon="@(IsRunning ? "fas fa-pause" : "fas fa-play")"
                Text="@(IsRunning ? "Pause" : "Play")"
                Disabled="@inputInvalid"
                OnClick="TogglePlayAsync" />
        <Button Icon="fas fa-rotate-left" Text="Restart" OnClick="RestartAsync" />
        <label for="@SpeedId" class="speed-label">Speed</label>
        <Select TValue="double" Id="@SpeedId" Value="@secondsPerSecond" ValueChanged="OnSpeedChanged">
            @foreach (var speed in SimulationSpeed.All)
            {
                <SelectItem TValue="double" Value="@speed.SecondsPerSecond">@speed.Label</SelectItem>
            }
        </Select>
    </div>

    <div class="panels">
        <FloatingPanel Title="Gases in the air" Class="gases-panel">
            <GasTable State="@state" Start="@start" />
        </FloatingPanel>
        <FloatingPanel Title="Gases over time" Class="chart-panel">
            <TimeSeriesChart @ref="gasChart"
                             Series="@GasSeries"
                             YTitle="Share of the air"
                             YUnit="%"
                             AriaLabel="Line chart of each gas's share of the air over time" />
        </FloatingPanel>
        @if (simulation is IPlanetSimulation planet)
        {
            <FloatingPanel Title="Radiative forcing" Class="forcing-panel">
                <ForcingChart Forcing="@planet.Forcing(state)" AriaLabel="Bar chart of the radiative forcing by agent now" />
                <EnergyReadouts Simulation="@planet" State="@state" />
            </FloatingPanel>
            <FloatingPanel Title="Temperature and forcing over time" Class="over-time-panel">
                <TimeSeriesChart @ref="temperatureChart"
                                 Series="@TemperatureSeries"
                                 YTitle="Temperature"
                                 YUnit="@AxisUnit(UnitOfMeasure.DegreesCelsius)"
                                 BeginAtZero="false"
                                 AriaLabel="Line chart of the planet's temperature over time" />
                <TimeSeriesChart @ref="energyChart"
                                 Series="@EnergySeries"
                                 YTitle="Forcing and energy"
                                 YUnit="@AxisUnit(UnitOfMeasure.WattsPerSquareMetre)"
                                 AriaLabel="Line chart over time of the forcing, the imbalance, and the change since the start in absorbed sunlight and heat to space" />
            </FloatingPanel>
        }
    </div>

    <div class="visually-hidden" aria-live="polite">@announcement</div>
</div>
