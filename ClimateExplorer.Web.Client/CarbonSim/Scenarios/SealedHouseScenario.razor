@using ClimateExplorer.Web.Client.CarbonSim.Components
@inherits ScenarioComponent

<div class="scenario">
    <div class="scenario-text">
        <h2>@Scenario.Title</h2>
        <p>
            A gas burner runs in a sealed @HouseVolumeText house with no windows and no sunlight. The house starts at
            @StartTemperatureText, the same as outside, so any change in temperature comes from the flame. The burner
            takes its oxygen from the house's air and stops when the oxygen falls below @CarbonSimFormat.Share(Scenario.Setting.OxygenCutOff).
        </p>
        <p class="note">
            To keep the pressure steady, a vent lets out nitrogen as the flame adds gas or warms the air. Nitrogen takes
            no part in burning and makes up most of the air, so letting only nitrogen out keeps the chemistry simple and
            stops the pressure building until the house bursts.
        </p>
        @if (Inputs.FossilFuels is not null)
        {
            <BurnerRateInput Value="@Inputs.FossilFuels" ValueChanged="OnFossilFuelsChangedAsync" Invalid="InputInvalid" />
        }
    </div>
    <ReactionSummary State="@State" Reaction="@House.Reaction" />
</div>
