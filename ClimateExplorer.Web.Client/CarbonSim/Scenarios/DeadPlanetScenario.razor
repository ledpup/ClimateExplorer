@using ClimateExplorer.CarbonCycle.Simulation
@using ClimateExplorer.Web.Client.CarbonSim.Components
@inherits ScenarioComponent

<div class="scenario">
    <div class="scenario-text">
        <h2>@Scenario.Title</h2>
        <p>
            Imagine Earth's atmosphere but little else: no ocean, no clouds, no plants.
            @CarsText cars drive at @SpeedText continuously. Each car burns @PerCarText of petrol (we're treating it as pure octane). There is nothing to take the CO₂ out of the air.
        </p>
        <p class="note">
            The sun warms the planet. The planet's average temperature is about @StartTemperatureText because dry air with a little CO₂ holds in little heat. The CO₂ the cars add
            holds in more heat, so less escapes to space than the planet absorbs, and it warms until the two match again. With no water vapour to add to the warming,
            that's about @PerDoublingText each time the CO₂ doubles, less than on Earth. The water the cars make
            @WaterFallsText.
        </p>
        @if (Inputs.FossilFuels is not null)
        {
            <CarCountInput Value="@Inputs.FossilFuels" ValueChanged="OnFossilFuelsChangedAsync" Invalid="InputInvalid" />
        }
    </div>
    <ReactionSummary State="@State" Reaction="@Planet.Reaction">
        <div>
            <dt>Water fallen as frost or rain</dt>
            <dd>@FallenOutText</dd>
        </div>
        <div>
            <dt>Heat kept in by the added CO₂</dt>
            <dd>@HeatFluxText(Forcing.Of(ForcingAgents.CarbonDioxide))</dd>
        </div>
        <div>
            <dt>Heat from the engines</dt>
            <dd>@HeatFluxText(Forcing.NonRadiativeHeat)</dd>
        </div>
    </ReactionSummary>
</div>
