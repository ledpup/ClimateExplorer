@using ClimateExplorer.Web.Client.Components.Co2
@using ClimateExplorer.Web.Client.Components.Notifications
@using ClimateExplorer.Web.Client.Components.RecentObservations
@using ClimateExplorer.Web.Client.UiModel.RecentObservations

<nav class="site-nav" aria-label="Main">
    <a class="site-nav-brand" href="">
        <div class="logo">
            <img src="/logo-50.png" width="42" height="42" alt="ClimateExplorer home" />
        </div>
    </a>
    <ul class="site-nav-list site-nav-start">
        @foreach (var item in primaryItems)
        {
            <li class="site-nav-item">
                <a class="site-nav-link" href="@item.Route" aria-current="@AriaCurrent(item.Route)">@item.Text</a>
            </li>
        }
        @foreach (var item in VisibleSecondaryItems)
        {
            <li class="site-nav-item desktop-secondary-nav-item">
                @if (item.OpensSiteOverview)
                {
                    <button type="button" class="site-nav-link" aria-label="Site overview" @onclick="() => SiteOverviewService!.RequestShow()">
                        <i class="fas fa-circle-info" aria-hidden="true"></i>
                    </button>
                }
                else
                {
                    <a class="site-nav-link" href="@item.Route" aria-current="@AriaCurrent(item.Route!)">@item.Text</a>
                }
            </li>
        }
        <li class="site-nav-item notification-nav-item">
            <NotificationBell />
        </li>
        <li class="site-nav-item mobile-menu-nav-item">
            <DropdownButton Icon="fas fa-bars" AriaLabel="More navigation options" Class="@HamburgerClass" AlignEnd="true">
                <MenuContent>
                    @foreach (var item in VisibleSecondaryItems)
                    {
                        if (item.OpensSiteOverview)
                        {
                            <DropdownItem Class="info-menu-item" aria-label="Site overview" OnClick="() => SiteOverviewService!.RequestShow()">
                                <i class="fas fa-circle-info" aria-hidden="true"></i> @item.Text
                            </DropdownItem>
                        }
                        else
                        {
                            <a class="dropdown-item" href="@item.Route" aria-current="@AriaCurrent(item.Route!)">@item.Text</a>
                        }
                    }
                    <hr class="dropdown-divider" />
                    <UnitSwitch Class="unit-switch-menu-item" />
                </MenuContent>
            </DropdownButton>
        </li>
    </ul>
    <ul class="site-nav-list site-nav-end">
        <li class="site-nav-item unit-switch-nav-item">
            <UnitSwitch />
        </li>
        <li class="site-nav-item options-nav-item">
            <DropdownButton Icon="fas fa-cog" AriaLabel="Options" Class="options-toggle" AlignEnd="true">
                <MenuContent>
                    <UnitSwitch Class="unit-switch-menu-item" />
                </MenuContent>
            </DropdownButton>
        </li>
        <li class="site-nav-item co2-nav-item">
            <Co2NavTile OnClick="ShowCo2PanelAsync" />
        </li>
    </ul>
</nav>

<SidePanel @ref="co2SidePanel" Title="Atmospheric CO₂" Width="85%">
    <RecentObservationsPanel Context="@RecentObservationsContext.ForAtmosphere()" DataSetDefinitions="@dataSetDefinitions" />
</SidePanel>
