@namespace ClimateExplorer.Web.Client.Components.RecentObservations
@using ClimateExplorer.Core.Model
@using ClimateExplorer.Web.Client.Services.Trends

<dl class="recent-observation-detail-metrics">
    @foreach (var metric in Metrics)
    {
        <div class="recent-observation-detail-metric">
            <dt>@metric.Label</dt>
            <dd>
                @if (!string.IsNullOrWhiteSpace(metric.UnavailableReason))
                {
                    <span class="recent-observation-detail-record">@metric.UnavailableReason</span>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(metric.RecentTrendValueText))
                    {
                        <Tooltip Text="@metric.RecentTrendTooltip" Multiline="true">
                            <div class="recent-observation-detail-headline">
                                <span class="recent-observation-detail-current @ValueClassifier.GetValueClass(metric.RecentTrendValueText, metric.IsRecentTrendPositive)">@metric.RecentTrendValueText</span>
                                <span class="recent-observation-detail-rank">@TrendWindowLabel.Get(TrendWindow.Last30).ToLowerInvariant()</span>
                            </div>
                        </Tooltip>
                    }
                    @if (!string.IsNullOrWhiteSpace(metric.Since1961TrendValueText))
                    {
                        <Tooltip Text="@metric.Since1961TrendTooltip" Multiline="true">
                            <span class="recent-observation-detail-record">@TrendWindowLabel.Get(TrendWindow.Since1961): <span class="@ValueClassifier.GetValueClass(metric.Since1961TrendValueText, metric.IsSince1961TrendPositive)">@metric.Since1961TrendValueText</span></span>
                        </Tooltip>
                    }
                    @if (!string.IsNullOrWhiteSpace(metric.FirstHalfTrendValueText))
                    {
                        <Tooltip Text="@metric.FirstHalfTrendTooltip" Multiline="true">
                            <span class="recent-observation-detail-record">@TrendWindowLabel.Get(TrendWindow.FirstHalf): <span class="@ValueClassifier.GetValueClass(metric.FirstHalfTrendValueText, metric.IsFirstHalfTrendPositive)">@metric.FirstHalfTrendValueText</span></span>
                        </Tooltip>
                    }
                }
            </dd>
        </div>
    }
    <div class="recent-observation-detail-metric recent-observation-trend-about">
        <TrendsAboutButton OnClick="@ShowAboutTrends" />
    </div>
</dl>
<AboutTrends @ref="aboutTrends" Metrics="@Metrics" DownloadRequested="@OnDownloadRequested" />
