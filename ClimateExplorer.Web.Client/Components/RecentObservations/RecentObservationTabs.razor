@namespace ClimateExplorer.Web.Client.Components.RecentObservations
@using ClimateExplorer.Web.Client.UiModel.RecentObservations

<Tabs SelectedTab="@SelectedTab" SelectedTabChanged="@OnSelectedTabChanged" AriaLabel="Observation domain" Class="mb-3">
    @foreach (var domain in Domains)
    {
        <Tab Name="@domain.Key">@domain.TabLabel</Tab>
    }
</Tabs>

@code {
    [Parameter]
    public IReadOnlyList<ObservationDomain> Domains { get; set; } = [];

    [Parameter]
    public string? SelectedTab { get; set; }

    [Parameter]
    public EventCallback<string> SelectedTabChanged { get; set; }

    private async Task OnSelectedTabChanged(string selectedTab)
    {
        await SelectedTabChanged.InvokeAsync(selectedTab);
    }
}
