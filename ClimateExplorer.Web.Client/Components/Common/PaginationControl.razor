<nav class="pagination @Class" aria-label="@AriaLabel">
    <ul>
        @foreach (var pageNum in GetVisiblePages())
        {
            @if (pageNum == -1)
            {
                <li class="pagination-gap" aria-hidden="true">&hellip;</li>
            }
            else
            {
                var pageNumber = pageNum;
                <li>
                    <button type="button"
                            class="pagination-page"
                            aria-current="@(CurrentPage == pageNumber ? "page" : null)"
                            aria-label="@($"Page {pageNumber}")"
                            @onclick="() => OnPageClicked(pageNumber)">@pageNumber</button>
                </li>
            }
        }
    </ul>
</nav>
