<div class="climate-dropdown">
    <button type="button" class="@CssClass" @ref="toggle"
            popovertarget="@(IsInteractive ? menuId : null)" disabled="@(!IsInteractive)"
            aria-label="@EffectiveAriaLabel" @attributes="AdditionalAttributes">
        @if (!string.IsNullOrWhiteSpace(Icon))
        {
            <i class="@Icon" aria-hidden="true"></i>
        }
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Text
        }
    </button>
    <div id="@menuId" popover="auto" class="climate-dropdown-menu" data-align="@(AlignEnd ? "end" : null)" @ref="menu">
        <CascadingValue Value="this" IsFixed="true">
            @MenuContent
        </CascadingValue>
    </div>
</div>
