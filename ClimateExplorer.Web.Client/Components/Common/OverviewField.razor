@using System.Text.RegularExpressions
@using ClimateExplorer.Web.Client.Components.Common

<DelayedTooltip Text="@(Tooltip == null ? Title : Tooltip)" Style="display: inline-block" Multiline="@TooltipMultiline">
    <div class="overview-field @(PopupContent != null || OnClick.HasDelegate ? "is-clickable" : "")" @onclick="HandleClick">
        <div class="label">@Label</div>
        <div class="value">
            @if (PopupContent != null || OnClick.HasDelegate)
            {
                <a class="popup-link">@Value</a>
            }
            else
            {
                @Value
            }
        </div>
        <div class="additional-info">@AdditionalInfo</div>
    </div>
</DelayedTooltip>

@if (PopupContent != null)
{
    <Modal @ref="popup" Title="@(string.IsNullOrWhiteSpace(PopupTitle) ? Label : PopupTitle)" Size="ModalSize.Large">
        @PopupContent
    </Modal>
}

