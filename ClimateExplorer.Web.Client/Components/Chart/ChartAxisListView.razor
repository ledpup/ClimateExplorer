@using Blazorise
@using ClimateExplorer.Web.Client.Components.Common

<div class="axes-dropdown-wrapper">
    <DropdownButton Text="Axes" Icon="fas fa-chart-line">
        <MenuContent>
            @if (Axes != null && Axes.Count > 0)
            {
                <div class="axes-menu-content">
                    <DropdownHeader>Scale from 0</DropdownHeader>
                    @foreach (var axis in Axes)
                    {
                        <ClimateCheckbox Class="climate-checkbox--menu-row"
                                         Value="@GetScaleToZero(axis.Id)"
                                         ValueChanged="@((bool v) => OnScaleToZeroChanged(axis.Id, v))">
                            @axis.Label
                        </ClimateCheckbox>
                    }
                </div>
            }
        </MenuContent>
    </DropdownButton>
</div>