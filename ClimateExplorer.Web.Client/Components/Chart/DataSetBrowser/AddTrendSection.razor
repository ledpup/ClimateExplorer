@using ClimateExplorer.Web.Client.Components.Chart.Trend
@using ClimateExplorer.Web.UiModel

<div class="add-trend-section">
    @if (EligibleSeries.Count == 0)
    {
        <div class="add-trend-empty">@EmptyMessage</div>
    }
    else
    {
        <Tooltip Text="Fit and project a trend for a series that's already on the chart" Style="display: block">
            <div class="form-row">
                <label class="form-label" for="@seriesSelectId">Series</label>
                <span class="form-control-wrap">
                    <Select TValue="Guid" Id="@seriesSelectId" Value="@SelectedSeries!.Id" ValueChanged="@OnSeriesSelected" aria-label="Series to add a trend to">
                        @foreach (var series in EligibleSeries)
                        {
                            <SelectItem Value="@series.Id">@series.GetFriendlyTitleShort()</SelectItem>
                        }
                    </Select>
                </span>
            </div>
        </Tooltip>

        @for (var i = 0; i < SelectedSeries!.Trends.Count; i++)
        {
            var index = i;
            <ChartSeriesTrendControls Request="@SelectedSeries.Trends[index]"
                                       Trend="@GetTrend(index)"
                                       SlotLabel="@GetTrendSlotLabel(index)"
                                       OnChanged="@OnTrendsChangedInternal"
                                       OnRemove="@(() => OnRemoveTrendClicked(index))" />
        }

        @if (SelectedSeries.Trends.Count < ChartSeriesDefinition.MaxTrends)
        {
            <Tooltip Text="Fit a trend and project it past the end of the data" Style="display: block">
                <button type="button" class="trend-add-button" @onclick="@OnAddTrendClicked">
                    <i class="fas fa-plus"></i> Add trend
                </button>
            </Tooltip>
        }
    }
</div>
