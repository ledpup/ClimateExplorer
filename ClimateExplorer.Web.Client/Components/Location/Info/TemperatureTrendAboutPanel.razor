@namespace ClimateExplorer.Web.Client.Components.Info
@using Blazorise
@using ClimateExplorer.Web.Client.Components.Common
@using ClimateExplorer.Web.Client.Components.Common.Trends
@using ClimateExplorer.Web.Client.Services.Trends

<SidePanel @ref="sidePanel" Title="About trends" Width="min(60%, 1024px)">
    <div class="trend-stats">
        <div class="climate-tabs trends-about-tabs">
            <Tabs SelectedTab="@selectedTab" SelectedTabChanged="@OnTabChanged">
                <Items>
                    <Tab Name="@OverviewTabName">Overview</Tab>
                    @foreach (var window in Windows)
                    {
                        <Tab Name="@TabName(window)">@TrendWindowLabel.Get(window.Window)</Tab>
                    }
                </Items>
            </Tabs>
        </div>

        @if (SelectedWindow is { } selected)
        {
            <p class="trend-stats-summary @(selected.IsSignificant ? string.Empty : "not-significant")">
                @DescribeWindow(selected)
            </p>

            <TrendStatTable Sections="@BuildSections(selected)" />

            <DelayedTooltip Text="Download the yearly data behind this trend">
                <button type="button" class="trends-download" aria-label="Download the yearly data behind this trend" @onclick="@(() => DownloadAsync(selected))">
                    <i class="fas fa-download" aria-hidden="true"></i> Download data
                </button>
            </DelayedTooltip>
        }
        else
        {
            <TrendsOverviewExplainer />
        }
    </div>
</SidePanel>
