@namespace ClimateExplorer.Web.Client.Components.Info
@using ClimateExplorer.Core.Model
@using ClimateExplorer.Web.Client.Components.Common
@using ClimateExplorer.Web.Client.Components.Location
@using ClimateExplorer.WebApiClient.Services
@using System

@if (Location != null && HeatingScoreTable != null)
{
    <p>The trend score, from 0 to 9, compares how fast a location has warmed since @StartYear with every other location in the dataset. Locations that have cooled score @Location.NegativeRateHeatingScore.</p>
    <p>@StartYear is the start of the World Meteorological Organization's 1961–1990 reference period, which is used to track long-term climate change. Every location is ranked on the same period, so a long record doesn't raise or lower its score.</p>
    <p>The middle @MiddlePercent% of warming rates is split into 10 equal steps, so a few outliers don't stretch the scale; locations beyond either end score 0 or 9. Because the steps are equal in width, not in number of locations, most locations score in the middle.</p>
    <p>A location needs at least @MinimumYears complete years of data from @StartYear, starting no later than @LatestFirstYear, to get a score. Its data must also run to within @MaximumYearsBehindNewest years of the newest data in the dataset.</p>

    @if (Location.HeatingScore.HasValue && Location.Since1961TemperatureTrend is not null)
    {
        <p>
            The warming rate since @StartYear for <strong>@Location.Name</strong> is <strong>@FormatLocationRate(Location)</strong>. Its trend score is <strong>@Location.HeatingScore</strong>, highlighted below.
            The dashboard's trend field shows the last 30 years first, when that trend is significant, so it can show a different rate.
        </p>
    }
    else
    {
        <p>
            <strong>@Location.Name</strong> doesn't have a trend score, because it doesn't have sufficient data.
        </p>
    }

    <div class="table-card">
        <div class="table-header">
            <span>Trend score table</span>
        </div>
        <table class="table table--striped table--compact">
            <thead>
                <tr>
                    <th scope="col"><strong>Trend score</strong></th>
                    <th scope="col" class="text-center"><strong>Warming rate since @StartYear (@RateUnitLabel)</strong></th>
                    <th scope="col" class="text-center"><strong>Locations</strong></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var heatingScoreRow in HeatingScoreTable)
                {
                    var row = heatingScoreRow;
                    <tr class="@GetRowClass(row)" @onclick="() => ShowLocationsAsync(row)">
                        <td>@(row.Score?.ToString() ?? "No score")</td>
                        <td>@(row.MinimumRatePerDecade is { } minimum && row.MaximumRatePerDecade is { } maximum ? $"{FormatBound(minimum)} - {FormatBound(maximum)}" : "NA")</td>
                        <td class="text-center">
                            @if (row.LocationCount > 0)
                            {
                                @* The row handles a mouse click anywhere on it; the button is for the keyboard and screen readers *@
                                <span @onclick:stopPropagation="true">
                                    <Button Variant="ButtonVariant.Link"
                                            Text="@row.LocationCount.ToString("N0")"
                                            AriaLabel="@($"List the {GetLocationsTitle(row).ToLowerInvariant()}")"
                                            OnClick="() => ShowLocationsAsync(row)" />
                                </span>
                            }
                            else
                            {
                                @row.LocationCount.ToString("N0")
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* Inside the modal's <dialog>, so it shows above the modal rather than behind it *@
<SidePanel @ref="locationsSidePanel" Title="@(selectedRow is null ? string.Empty : GetLocationsTitle(selectedRow))" Width="85%" AllowExpand="true">
    @if (selectedRow is not null)
    {
        <LocationsTable ShowFilters="false"
                        HeatingScore="@LocationsTable.GetHeatingScoreFilter(selectedRow.Score)"
                        LocationLinkClicked="CloseModalAsync" />
    }
</SidePanel>
