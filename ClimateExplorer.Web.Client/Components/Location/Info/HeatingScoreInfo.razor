@namespace ClimateExplorer.Web.Client.Components.Info
@using ClimateExplorer.Core.Model
@using ClimateExplorer.WebApiClient.Services
@using System

@if (Location != null && HeatingScoreTable != null)
{
    <p>The heating score is a number between 0 and 9 that compares how fast a location has warmed with every other location in the dataset. It ranks each location's warming rate since @StartYear into 10 equal groups, or <a href="https://en.wikipedia.org/wiki/Decile" target="_blank">deciles</a>. The fastest-warming 10% of locations score 9 and the slowest 10% score 0. A location whose rate since @StartYear is negative scores @Location.NegativeRateHeatingScore, to highlight any location that has not warmed.</p>
    <p>@StartYear is the start of the World Meteorological Organization's 1961–1990 reference period, which is used to track long-term climate change. Every location is ranked on the same period, so a long record doesn't raise or lower its score.</p>
    <p>A location needs at least @MinimumYears complete years of data from @StartYear, starting no later than @LatestFirstYear, to get a score. Its data must also run to within @MaximumYearsBehindNewest years of the newest data in the dataset.</p>

    @if (Location.HeatingScore.HasValue && Location.Since1961TemperatureTrend is not null)
    {
        <p>
            The warming rate since @StartYear for <strong>@Location.Name</strong> is <strong>@FormatLocationRate(Location)</strong>. Its heating score is <strong>@Location.HeatingScore</strong>@(Location.HeatingScore >= 0 ? ", highlighted below" : string.Empty).
            The dashboard's trend field shows the last 30 years first, when that trend is significant, so it can show a different rate.
        </p>
    }
    else
    {
        <p>
            <strong>@Location.Name</strong> doesn't have a heating score, because it doesn't have sufficient data.
        </p>
    }

    <p>
        The table below lists each heating score and the range of warming rates it covers.
    </p>

    <div class="table-card">
        <div class="table-header">
            <span>Heating score table</span>
        </div>
        <table class="table table--striped table--compact">
            <thead>
                <tr>
                    <th scope="col"><strong>Heating score</strong></th>
                    <th scope="col" class="text-center"><strong>Warming rate since @StartYear (@RateUnitLabel)</strong></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var heatingScoreRow in HeatingScoreTable)
                {
                    <tr class="@(Location.HeatingScore == heatingScoreRow.Score ? "is-highlighted" : null)">
                        <td>@heatingScoreRow.Score</td>
                        <td>@FormatBound(heatingScoreRow.MinimumRatePerDecade) - @FormatBound(heatingScoreRow.MaximumRatePerDecade)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
