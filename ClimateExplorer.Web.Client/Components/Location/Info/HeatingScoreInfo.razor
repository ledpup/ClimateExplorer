@namespace ClimateExplorer.Web.Client.Components.Info
@using ClimateExplorer.Core.Model
@using ClimateExplorer.WebApiClient.Services
@using System

@if (Location != null && HeatingScoreTable != null)
{
    <p>The heating score is a number between 0 and 9. It is calculated by ordering all warming anomalies across the locations in the dataset into 10 sets of <a href="https://en.wikipedia.org/wiki/Percentile" target=" _blank">percentiles</a>. Each set is a single heating score and it represents 10% of the total number of locations.</p>
    <p>For example, the top ten 10% of warming anomalies are scored as a 9, the bottom 10% are scored as 0.</p>
    <p>Negative warming anomalies are scored differently; they use the warming anomaly, rounded to zero decimal places as the score. This is to highlight any location that has not warmed.</p>
    <p>Although the heating score compares locations, its not a fully standardised metric. The major factors influencing scores are:</p>
    <ul>
        <li>Stations that have been operating for a long time. The effect of global warming is more obvious when there are many records as temperature records in the past were cooler for most locations.</li>
        <li>Inland vs coastal locations. The ocean is warming more slowly compared with the land. Therefore, coastal locations are likely to have warmed less than inland locations.</li>
    </ul>
    <p>
        The table below lists each heating score and the range of warming anomalies that bound the score.
    </p>

    @if (Location.WarmingAnomaly.HasValue)
    {
        <p>
            The warming anomaly for <strong>@Location.Name</strong> is <strong>@FormatLocationAnomaly(Location)</strong>. Its heating score is <strong>@Location.HeatingScore</strong>, highlighted below.
        </p>
    }
    
    <div class="table-card">
        <div class="table-header">
            <span>Heating score table</span>
        </div>
        <table class="table table--striped table--compact">
            <thead>
                <tr>
                    <th scope="col"><strong>Heating score</strong></th>
                    <th scope="col" class="text-center"><strong>Warming anomaly range (@AnomalyUnitLabel)</strong></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var heatingScoreRow in HeatingScoreTable)
                {
                    <tr class="@(Location.HeatingScore == heatingScoreRow.Score ? "is-highlighted" : null)">
                        <td>@heatingScoreRow.Score</td>
                        <td>@FormatBound(heatingScoreRow.MinimumWarmingAnomaly) - @FormatBound(heatingScoreRow.MaximumWarmingAnomaly)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}