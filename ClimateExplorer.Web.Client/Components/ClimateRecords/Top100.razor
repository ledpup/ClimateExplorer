@namespace ClimateExplorer.Web.Client.Components.Location
@using ClimateExplorer.Web.Client.Components.Common
@using ClimateExplorer.Web.Client.UiModel

<LoadingIndicator Visible="@IsLoading">
    <div @ref="spaceRef" class="top100-space">
    @if (YearCounts.Count > 0 && ChartWidth > 0)
    {
        <div class="mt-3">
            <div class="top100-svg-container">
                <svg @ref="svgRef" xmlns="http://www.w3.org/2000/svg" width="@ChartWidth" height="@Top100Model.ChartHeight" viewBox="0 0 @ChartWidth @Top100Model.ChartHeight" font-family="@Top100Model.FontFamily" class="top100-svg">
                    <rect width="@ChartWidth" height="@Top100Model.ChartHeight" fill="#ffffff" />
                    <text x="@(ChartWidth / 2)" y="@Top100Model.TitleY" text-anchor="middle" font-size="@Top100Model.FontSize" font-weight="bold" fill="#000">@BuildTitle()</text>
                    <text x="@(ChartWidth / 2)" y="@Top100Model.SubtitleY" text-anchor="middle" font-size="@Top100Model.FontSize" fill="#000">@BuildSubtitle()</text>
                    @((MarkupString)Top100Model.Generate(YearCounts, StartYear, EndYear, ChartWidth))
                </svg>
            </div>
            <div class="top100-actions">
                <Tooltip Text="Copy the chart as an image to the clipboard">
                    <Button Text="Copy" Icon="fas fa-copy" Class="top100-btn" OnClick="CopyAsImage" />
                </Tooltip>
                <Tooltip Text="Download the chart as a PNG or SVG file">
                    <div class="top100-download-dropdown-wrapper">
                        <DropdownButton Text="Download" Icon="fas fa-download">
                            <MenuContent>
                                <DropdownItem OnClick="DownloadImage">PNG</DropdownItem>
                                <DropdownItem OnClick="DownloadSvg">SVG</DropdownItem>
                            </MenuContent>
                        </DropdownButton>
                    </div>
                </Tooltip>
            </div>
        </div>
    }
    </div>
</LoadingIndicator>

<h3>Top 100</h3>
<p>A barcode-like chart that shows how the top 100 daily records are distributed across years.</p>
<ul>
    <li>Each vertical bar represents a year that contributes at least one record to the top 100.</li>
    <li>A wider bar means more records from that year appear in the top 100.</li>
    <li>Hover over a bar to see that year's records: its rank in the top 100, the date, and the value.</li>
</ul>
<p>In a stable climate, bars would be spread evenly across the full record. Clustering towards recent years is a signal of a warming trend; clustering towards earlier years suggests cooling.</p>
