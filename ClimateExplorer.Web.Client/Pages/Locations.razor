@page "/locations"
@using ClimateExplorer.Web.Client.Components.ClimateRecords
@using ClimateExplorer.Web.Client.Components.Common
@using ClimateExplorer.Web.Client.Components.Location
@using ClimateExplorer.Web.Client.Components.RecentObservations
@using ClimateExplorer.Web.Client.UiModel.RecentObservations

<PageTitle>ClimateExplorer - Locations</PageTitle>

<HeadContent>
    <meta name="description" content="Browse all climate observation locations in ClimateExplorer." />
    <meta property="og:title" content="Locations - ClimateExplorer" />
    <meta property="og:url" content="https://climateexplorer.net/locations" />
</HeadContent>

<div class="locations-container">
    @if (allLocations.Count == 0)
    {
        <LoadingIndicator Visible="true">
            <div class="loading-placeholder"></div>
        </LoadingIndicator>
    }
    else
    {
        <div class="table-card">
            <div class="table-header">
                <div class="toolbar-filters">
                    <div class="name-filter-wrapper">
                        <input type="text"
                               class="form-control form-control-sm"
                               placeholder="Search locations..."
                               aria-label="Search locations"
                               value="@(nameFilter ?? string.Empty)"
                               @oninput="@(e => OnNameFilterChanged(e.Value?.ToString()))" />
                    </div>
                    <DelayedTooltip Text="Filter locations by country">
                        <Select TValue="string"
                                Value="@(countryFilter ?? string.Empty)"
                                ValueChanged="@OnCountryFilterChanged"
                                aria-label="Country">
                            <SelectItem Value="@string.Empty">All countries</SelectItem>
                            @foreach (var country in availableCountries)
                            {
                                <SelectItem Value="@country">@(country.Length > 20 ? country[..20] + "…" : country)</SelectItem>
                            }
                        </Select>
                    </DelayedTooltip>
                    <DelayedTooltip Text="Filter locations by heating score, a measure of how much a location has warmed relative to all other locations.<br>The score is created by ordering all anomalies and grouping into deciles." Multiline="true">
                        <Select TValue="string"
                                Value="@(heatingScoreFilter ?? string.Empty)"
                                ValueChanged="@OnHeatingScoreFilterChanged"
                                aria-label="Heating score">
                            <SelectItem Value="@string.Empty">Any heating score</SelectItem>                       
                            @for (var i = 9; i >= 0; i--)
                            {
                                var score = i;
                                <SelectItem Value="@score.ToString()">@score</SelectItem>
                            }
                            <SelectItem Value="@HeatingScoreFilterNegative">Negative (&lt; 0)</SelectItem>
                            <SelectItem Value="@HeatingScoreFilterNullScore">No heating score</SelectItem>
                        </Select>
                    </DelayedTooltip>
                </div>
                <span class="location-count">@filteredCount location@(filteredCount == 1 ? string.Empty : "s")</span>
            </div>
            <table class="climate-table climate-table--striped locations-table">
                <thead>
                    <tr>
                        <th scope="col" class="name-col" aria-sort="@GetAriaSort("name")">
                            <button type="button" class="sort-button" @onclick='() => OnSortChanged("name")'><strong>Name <i class="fas @GetSortIconClass("name")" aria-hidden="true"></i></strong></button>
                        </th>
                        <th scope="col" class="country-col text-center" aria-sort="@GetAriaSort("country")">
                            <button type="button" class="sort-button" @onclick='() => OnSortChanged("country")'><strong>Country <i class="fas @GetSortIconClass("country")" aria-hidden="true"></i></strong></button>
                        </th>
                        <th scope="col" class="anomaly-col text-center" aria-sort="@GetAriaSort("anomaly")">
                            <button type="button" class="sort-button" @onclick='() => OnSortChanged("anomaly")'><strong>Warming anomaly <i class="fas @GetSortIconClass("anomaly")" aria-hidden="true"></i></strong></button>
                        </th>
                        <th scope="col" class="heating-col text-center" aria-sort="@GetAriaSort("heatingscore")">
                            <button type="button" class="sort-button" @onclick='() => OnSortChanged("heatingscore")'><strong>Heating score <i class="fas @GetSortIconClass("heatingscore")" aria-hidden="true"></i></strong></button>
                        </th>
                        <th scope="col" class="trend-col text-center" aria-sort="@GetAriaSort("trend")">
                            <button type="button" class="sort-button" @onclick='() => OnSortChanged("trend")'>
                                <strong>Temperature trend <i class="fas @GetSortIconClass("trend")" aria-hidden="true"></i></strong>
                                <span class="trend-subheader">per decade</span>
                            </button>
                        </th>
                        <th scope="col" class="data-types-col text-center">
                            <strong>Data types</strong>
                        </th>
                        <th scope="col" class="data-sources-col text-center">
                            <strong>Data sources</strong>
                        </th>
                        <th scope="col" class="recent-observations-col text-center">
                            <strong>Recent observations</strong>
                        </th>
                        <th scope="col" class="record-high-col text-end" aria-sort="@GetAriaSort("recordhigh")">
                            <button type="button" class="sort-button" @onclick='() => OnSortChanged("recordhigh")'><strong>Record high <i class="fas @GetSortIconClass("recordhigh")" aria-hidden="true"></i></strong></button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var location in PagedLocations)
                    {
                        <tr>
                            <td><a href="location/@location.UrlReadyName()">@location.Name</a></td>
                            <td class="country-cell">@(location.Country ?? location.CountryCode)</td>
                            <td class="anomaly-cell text-center">@FormatAnomaly(location)</td>
                            <td class="text-center">
                                @if (location.HeatingScore.HasValue)
                                {
                                    <span class="heating-badge" style="@GetHeatingScoreBadgeStyle(location.HeatingScore.Value)">@location.HeatingScore</span>
                                }
                                else
                                {
                                    <span>&#x2014;</span>
                                }
                            </td>
                            <td class="trend-cell text-center">@GetTrendDisplay(location.Id)</td>
                            <td class="data-types-cell">@GetDataTypesDisplay(location.Id)</td>
                            <td class="data-sources-cell">
                                @if (HasDataSources(location.Id))
                                {
                                    <ClimateButton Variant="ButtonVariant.Link"
                                                   Text="@GetDataSourcesDisplay(location.Id)"
                                                   AriaLabel="@($"View data sources for {location.Name}")"
                                                   Class="data-sources-link"
                                                   OnClick="@(() => ShowDataSetMetadataAsync(location))" />
                                }
                                else
                                {
                                    <span>&#x2014;</span>
                                }
                            </td>
                            <td class="recent-observations-cell text-center">
                                <ClimateButton Variant="ButtonVariant.Link" Text="View" Class="record-link" OnClick="@(() => ShowRecentObservationsAsync(location))" />
                            </td>
                            <td class="@(location.RecordHigh is null ? null : "text-end")">
                                @if (location.RecordHigh is not null)
                                {
                                    <ClimateButton Variant="ButtonVariant.Link" Text="@FormatRecordHigh(location)" Class="record-link" OnClick="@(() => ShowClimateRecordsAsync(location))" />
                                }
                                else
                                {
                                    <span class="text-center">&#x2014;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (filteredCount > 0)
            {
                <div class="table-footer">
                    <div class="d-flex flex-column flex-md-row align-items-center justify-content-between gap-2">
                        <div class="d-flex flex-wrap align-items-center justify-content-center gap-4">
                            <PaginationControl TotalPages="@totalPages"
                                               CurrentPage="@currentPage"
                                               PageChanged="@OnPageChanged"
                                               AriaLabel="Locations pages" />
                            <div class="d-flex align-items-center gap-1">
                                <Select TValue="int"
                                        Value="@pageSize"
                                        ValueChanged="@OnPageSizeChanged"
                                        aria-label="Locations per page">
                                    <SelectItem Value="10">10</SelectItem>
                                    <SelectItem Value="15">15</SelectItem>
                                    <SelectItem Value="20">20</SelectItem>
                                    <SelectItem Value="25">25</SelectItem>
                                    <SelectItem Value="50">50</SelectItem>
                                    <SelectItem Value="100">100</SelectItem>
                                </Select>
                            </div>
                        </div>
                        <span class="text-muted">@StartRecord&#x2013;@EndRecord of @filteredCount</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

<SidePanel @ref="climateRecordsSidePanel" Title="@("Climate records for " + Location?.Name)">
    <ClimateRecords Location="@Location" DataSetDefinitions="@DataSetDefinitions" />
</SidePanel>

<SidePanel @ref="recentObservationsSidePanel" Title="@("Recent observations for " + Location?.Name)" Width="85%">
    <RecentObservationsPanel Context="@RecentObservationsContext.ForLocation(Location)" Location="@Location" DataSetDefinitions="@DataSetDefinitions" />
</SidePanel>

<LocationDataSetMetadataSidePanel @ref="dataSetMetadataSidePanel" DataSetDefinitions="@DataSetDefinitions" Width="50%" />
