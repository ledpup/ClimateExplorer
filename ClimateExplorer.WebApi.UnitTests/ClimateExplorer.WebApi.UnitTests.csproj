<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>

    <!-- DataSetDownloadMetadataTests.ValidateAsync_StageOnePackagedSources_AllMatchTheirConfiguredReaders parses
         millions of rows across parallel threads; workstation GC serialises them on collections (~1.7x slower,
         measured 2026-10-28). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Update="GlacierFixtures/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Moq" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClimateExplorer.Core\ClimateExplorer.Core.csproj" />
    <ProjectReference Include="..\ClimateExplorer.Data.Downloading\ClimateExplorer.Data.Downloading.csproj" />
    <ProjectReference Include="..\ClimateExplorer.Data.Ghcnm\ClimateExplorer.Data.Ghcnm.csproj" />
    <ProjectReference Include="..\ClimateExplorer.DataPipeline\ClimateExplorer.DataPipeline.csproj" />
    <ProjectReference Include="..\ClimateExplorer.WebApi\ClimateExplorer.WebApi.csproj" />
  </ItemGroup>

</Project>
