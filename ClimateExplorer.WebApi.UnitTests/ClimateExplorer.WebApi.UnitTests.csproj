<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>

    <!-- The packaged-source validation tests parse millions of rows across parallel threads; workstation GC
         serialises them on collections (~2.5x slower than server GC). -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <None Update="GlacierFixtures/**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.0.2" />
    <PackageReference Include="MSTest.TestFramework" Version="4.0.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClimateExplorer.Core\ClimateExplorer.Core.csproj" />
    <ProjectReference Include="..\ClimateExplorer.Data.Downloading\ClimateExplorer.Data.Downloading.csproj" />
    <ProjectReference Include="..\ClimateExplorer.Data.Ghcnm\ClimateExplorer.Data.Ghcnm.csproj" />
    <ProjectReference Include="..\ClimateExplorer.DataPipeline\ClimateExplorer.DataPipeline.csproj" />
    <ProjectReference Include="..\ClimateExplorer.WebApi\ClimateExplorer.WebApi.csproj" />
  </ItemGroup>

</Project>
